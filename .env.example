# ==============================================================================
# Environment Configuration for Hybrid RAG Systems
# Copy this file to .env and set your active API keys
# ==============================================================================

# OpenAI API Key (Used for LLM calls, text-embedding-3-small, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Cohere API Key (Used for Day 14 Cohere Rerank)
COHERE_API_KEY=your_cohere_api_key_here

# Optional: Pinecone API Key (Used for managed vector DB examples)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws

# Note: Many days (from-scratch embeddings, TF-IDF, BM25, Cosine similarity, 
# FAISS, local SentenceTransformers) run completely locally WITHOUT any API keys!
